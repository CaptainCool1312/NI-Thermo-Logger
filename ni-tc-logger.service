[Unit]
Description=NI-9213 Thermocouple Data Logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/opt/ni-tc-logger
ExecStart=/opt/ni-tc-logger/.venv/bin/python /opt/ni-tc-logger/logger.py
Restart=always
RestartSec=10

# Give the process enough time to close the DAQ task cleanly.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
